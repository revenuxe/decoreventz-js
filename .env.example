NEXT_PUBLIC_SUPABASE_URL=https://qnptiezbwylqhgniapyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Production domain — used by metadataBase, sitemap.xml and robots.txt
# (see src/lib/site.ts). Defaults to https://www.decoreventz.com if unset.
NEXT_PUBLIC_SITE_URL=https://www.decoreventz.com

# AWS S3 — image storage for catalog (admin) and booking reference images.
# Server-only; the browser only ever talks to /api/upload, never AWS
# directly. See src/lib/s3.ts / src/app/api/upload/route.ts.
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — a CDN/custom-domain override (e.g. CloudFront) for public
# image URLs. Defaults to https://<bucket>.s3.<region>.amazonaws.com.
# Use https://dxxxxxxxxxxxx.cloudfront.net (a hostname alone also works).
AWS_S3_PUBLIC_URL=
