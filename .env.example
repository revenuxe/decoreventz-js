NEXT_PUBLIC_SUPABASE_URL=https://qnptiezbwylqhgniapyz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site domain is fixed to https://www.decoreventz.com in src/lib/site.ts.

# Images use Supabase Storage with the signed-in session; no extra storage credentials.

# Resend transactional email. These values are SERVER-ONLY.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Decor Eventz <notifications@decoreventz.com>"
EMAIL_ADMIN_TO=decoreventz.com@gmail.com
EMAIL_REPLY_TO=decoreventz.com@gmail.com
RESEND_WEBHOOK_SECRET=
# Generate two different random secrets (at least 32 bytes each).
CRON_SECRET=
CONTACT_RATE_LIMIT_SECRET=
# See docs/email-setup.md: Supabase migration + minute scheduler required.
